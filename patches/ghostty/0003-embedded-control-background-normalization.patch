+        fn normalizePenggieEmbeddedControlBackground(
+            self: *const Self,
+            bg: ?terminal.color.RGB,
+            style: terminal.Style,
+            cell: *const terminal.Cell,
+        ) ?terminal.color.RGB {
+            const source = self.config.penggie_embedded_control_background_source orelse return bg;
+            const target = self.config.penggie_embedded_control_background_target orelse return bg;
+
+            const explicit_bg: terminal.color.RGB = switch (cell.content_tag) {
+                .bg_color_rgb => rgb: {
+                    const raw = cell.content.color_rgb;
+                    break :rgb .{ .r = raw.r, .g = raw.g, .b = raw.b };
+                },
+                else => switch (style.bg_color) {
+                    .rgb => |rgb| rgb,
+                    else => return bg,
+                },
+            };
+
+            if (explicit_bg.eql(source)) return target;
+            return bg;
+        }
