+    /// Read the visible viewport as a compact JSON screen model. This is
+    /// intentionally scoped to embedded hosts that need structured row/cursor
+    /// data without taking ownership of terminal state.
+    export fn ghostty_surface_read_screen_model(
+        surface: *Surface,
+        result: *Text,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const screen = core_surface.renderer_state.terminal.screens.active;
+        const selection: terminal.Selection = .{
+            .bounds = .{ .untracked = .{
+                .start = screen.pages.getTopLeft(.viewport),
+                .end = screen.pages.getBottomRight(.viewport) orelse return false,
+            } },
+            .rectangle = false,
+        };
+
+        var text = core_surface.dumpTextLocked(
+            global.alloc,
+            selection,
+        ) catch |err| {
+            log.warn("error reading screen model text err={}", .{err});
+            return false;
+        };
+        defer text.deinit(global.alloc);
+
+        var stream: std.Io.Writer.Allocating = .init(global.alloc);
+        defer stream.deinit();
+        writeScreenModelJSON(
+            &stream.writer,
+            screen,
+            text.text,
+            core_surface.size.grid().columns,
+            core_surface.size.grid().rows,
+            screen.cursor.x,
+            screen.cursor.y,
+            core_surface.io.terminal.modes.get(.cursor_visible),
+        ) catch |err| {
+            log.warn("error writing screen model json err={}", .{err});
+            return false;
+        };
+
+        const owned = stream.toOwnedSliceSentinel(0) catch |err| {
+            log.warn("error allocating screen model json err={}", .{err});
+            return false;
+        };
+
+        result.* = .{
+            .tl_px_x = -1,
+            .tl_px_y = -1,
+            .offset_start = 0,
+            .offset_len = 0,
+            .text = owned.ptr,
+            .text_len = owned.len,
+        };
+
+        return true;
+    }
+
+    fn writeScreenModelJSON(
+        writer: *std.Io.Writer,
+        screen: anytype,
+        text: [:0]const u8,
+        columns: u32,
+        rows: u32,
+        cursor_x: usize,
+        cursor_y: usize,
+        cursor_visible: bool,
+    ) !void {
+        try writer.print(
+            "{{\"columns\":{d},\"rows\":{d},\"cursor\":{{\"x\":{d},\"y\":{d},\"visible\":{}}},\"lines\":[",
+            .{ columns, rows, cursor_x, cursor_y, cursor_visible },
+        );
+
+        var line_index: usize = 0;
+        var line_iter = std.mem.splitScalar(u8, text, '\n');
+        while (line_iter.next()) |line| : (line_index += 1) {
+            if (line_index > 0) try writer.writeByte(',');
+            try writer.print(
+                "{{\"index\":{d},\"text\":{f},\"selected\":false,\"firstNonBlankColumn\":",
+                .{ line_index, std.json.fmt(line, .{ .whitespace = .minified }) },
+            );
+            if (firstNonBlankColumn(line)) |column| {
+                try writer.print("{d}", .{column});
+            } else {
+                try writer.writeAll("null");
+            }
+
+            try writer.writeAll(",\"lastNonBlankColumn\":");
+            if (lastNonBlankColumn(line)) |column| {
+                try writer.print("{d}", .{column});
+            } else {
+                try writer.writeAll("null");
+            }
+
+            try writer.writeAll(",\"styleSummary\":");
+            try writeScreenModelStyleSummaryJSON(
+                writer,
+                screenModelStyleSummaryForViewportRow(screen, line_index),
+            );
+            try writer.writeByte('}');
+        }
+
+        try writer.writeAll("]}");
+    }
+
+    const ScreenModelStyleSummary = struct {
+        text_cell_count: usize = 0,
+        selected_cell_count: usize = 0,
+        selected_text_cell_count: usize = 0,
+        bold_text_cell_count: usize = 0,
+        faint_text_cell_count: usize = 0,
+        inverse_text_cell_count: usize = 0,
+        background_text_cell_count: usize = 0,
+        foreground_text_cell_count: usize = 0,
+    };
+
+    fn screenModelStyleSummaryForViewportRow(
+        screen: anytype,
+        viewport_row_index: usize,
+    ) ScreenModelStyleSummary {
+        var summary: ScreenModelStyleSummary = .{};
+        var row_index: usize = 0;
+        var row_iter = screen.pages.rowIterator(.right_down, .{ .viewport = .{} }, null);
+        while (row_iter.next()) |row_pin| : (row_index += 1) {
+            if (row_index != viewport_row_index) continue;
+
+            for (row_pin.cells(.all)) |*cell| {
+                if (!cell.hasText()) continue;
+
+                summary.text_cell_count += 1;
+                const style = row_pin.style(cell);
+                if (style.flags.bold) summary.bold_text_cell_count += 1;
+                if (style.flags.faint) summary.faint_text_cell_count += 1;
+                if (style.flags.inverse) summary.inverse_text_cell_count += 1;
+                if (screenModelColorIsPresent(style.bg_color)) summary.background_text_cell_count += 1;
+                if (screenModelColorIsPresent(style.fg_color)) summary.foreground_text_cell_count += 1;
+            }
+
+            return summary;
+        }
+
+        return summary;
+    }
+
+    fn screenModelColorIsPresent(color: terminal.Style.Color) bool {
+        return switch (color) {
+            .none => false,
+            .palette, .rgb => true,
+        };
+    }
+
+    fn writeScreenModelStyleSummaryJSON(
+        writer: *std.Io.Writer,
+        summary: ScreenModelStyleSummary,
+    ) !void {
+        try writer.print(
+            "{{\"textCellCount\":{d},\"selectedCellCount\":{d},\"selectedTextCellCount\":{d},\"boldTextCellCount\":{d},\"faintTextCellCount\":{d},\"inverseTextCellCount\":{d},\"backgroundTextCellCount\":{d},\"foregroundTextCellCount\":{d}}}",
+            .{
+                summary.text_cell_count,
+                summary.selected_cell_count,
+                summary.selected_text_cell_count,
+                summary.bold_text_cell_count,
+                summary.faint_text_cell_count,
+                summary.inverse_text_cell_count,
+                summary.background_text_cell_count,
+                summary.foreground_text_cell_count,
+            },
+        );
+    }
+
+    fn firstNonBlankColumn(line: []const u8) ?usize {
+        for (line, 0..) |byte, index| {
+            if (byte != ' ' and byte != '\t' and byte != '\r') return index;
+        }
+        return null;
+    }
+
+    fn lastNonBlankColumn(line: []const u8) ?usize {
+        var index = line.len;
+        while (index > 0) {
+            index -= 1;
+            const byte = line[index];
+            if (byte != ' ' and byte != '\t' and byte != '\r') return index;
+        }
+        return null;
+    }
+
     fn readTextLocked(
         surface: *Surface,
         core_sel: terminal.Selection,
